<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.CALL_PHONE" />
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <uses-permission android:name="android.permission.WRITE_CONTACTS" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.VIBRATE" />

  <queries>
    <!-- Android 11+ hides other packages: without this the speech recogniser
         reports itself unavailable even when one is installed. -->
    <intent>
      <action android:name="android.speech.RecognitionService" />
    </intent>
    <package android:name="com.whatsapp" />
    <package android:name="com.whatsapp.w4b" />
  </queries>

  <application>
    <!-- Download the on-device subject segmentation model at install time (call screen depth effect). -->
    <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="subject_segment" />

    <!-- Bound by Android when this app is the default phone app. Drives the in-call screen. -->
    <service
      android:name="expo.modules.dialer.DialerInCallService"
      android:exported="true"
      android:foregroundServiceType="phoneCall"
      android:permission="android.permission.BIND_INCALL_SERVICE">
      <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
      <!-- the app plays the ringtone itself (many phones, e.g. Xiaomi, leave it to the phone app) -->
      <meta-data android:name="android.telecom.IN_CALL_SERVICE_RINGING" android:value="true" />
      <intent-filter>
        <action android:name="android.telecom.InCallService" />
      </intent-filter>
    </service>

    <receiver android:name="expo.modules.dialer.CallActionReceiver" android:exported="false" />

    <service
      android:name="expo.modules.dialer.RecordingService"
      android:exported="false"
      android:foregroundServiceType="microphone" />

    <!-- Call island around the selfie camera (accessibility windows sit above the status bar). -->
    <service
      android:name="expo.modules.dialer.IslandAccessibilityService"
      android:exported="true"
      android:label="@string/dialer_island_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/dialer_island_service" />
    </service>

    <activity
      android:name="expo.modules.dialer.AnswerActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:noHistory="true"
      android:showWhenLocked="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:turnScreenOn="true" />
  </application>
</manifest>
